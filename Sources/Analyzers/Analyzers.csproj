<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier">

    <PropertyGroup>
        <!-- Roslyn analyzers MUST target netstandard2.0 (they run inside the compiler/IDE host). -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <SelfContained>false</SelfContained>
        <RuntimeIdentifier></RuntimeIdentifier>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DevOnBike.Overfit.Analyzers</RootNamespace>
        <AssemblyName>DevOnBike.Overfit.Analyzers</AssemblyName>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>false</IsPackable>
        <!-- The Microsoft.CodeAnalysis version must be <= the SDK's compiler version (4.14 is safe on .NET 10). -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>

    <!-- AnalyzerReleases.{Shipped,Unshipped}.md are NOT listed here on purpose. Microsoft.CodeAnalysis.Analyzers
         adds them as AdditionalFiles itself, so an explicit include registers each file twice. `dotnet build`
         tolerates the duplicate silently; Roslyn's own workspace does not, and rejects the whole project with
         "duplicate source file" — which means every IDE-style or tooling query over this project returns
         nothing rather than an error. Found by Tools/SemanticNavigator on 2026-08-06. -->


</Project>
