# OVERFIT004 stays at the global suggestion in Ops/: training graph-ops dispatch through
# OverfitParallel.For(Action<int>) closures BY DESIGN (Spans cannot cross a delegate boundary —
# see the comment in TensorMath.Normalization). The zero-alloc CONTRACT is the inference path
# (fn-pointer ForDecode); training is allocation-quiet (~4.6 KB/batch, MNIST audit), not zero.
dotnet_diagnostic.OVERFIT005.severity = warning
dotnet_diagnostic.OVERFIT006.severity = warning
dotnet_diagnostic.OVERFIT007.severity = warning
dotnet_diagnostic.OVERFIT009.severity = warning

# CTC family — known per-call-allocation backlog (beam search needs a redesign, not a mechanical
# swap) on the OCR/training path, which is NOT serving-hot. Kept visible as IDE suggestions;
# revisit (and re-escalate) if OCR gets productised.
[Sources/Main/Ops/{CtcDecoder.cs,CtcLoss.cs,NGramCtcLanguageModel.cs}]
dotnet_diagnostic.OVERFIT001.severity = suggestion
dotnet_diagnostic.OVERFIT003.severity = suggestion
dotnet_diagnostic.OVERFIT005.severity = suggestion
dotnet_diagnostic.OVERFIT006.severity = suggestion
dotnet_diagnostic.OVERFIT009.severity = suggestion

# Runtime/ ESCALATED 2026-06-12 after the prefill-pooling sweep (85 sites -> 0: batched-prefill
# scratch pooled via PooledBuffer.RentArray with exact-length slices — measured 748 MB -> ~1 MB
# allocated per 272-token prefill, greedy output bit-identical; load-time/by-contract sites carry
# justified #pragma). Per-call heap arrays in the serving runtime are a build warning from here on.
[Sources/Main/LanguageModels/Runtime/**.cs]
dotnet_diagnostic.OVERFIT001.severity = warning

# Whisper/ ESCALATED 2026-06-13 after the speech-to-text sweep: per-call scratch in the encoder/
# decoder/kernels (per-frame, per-token hot path) pooled via PooledBuffer.RentArray with exact-length
# slices; load-time/by-contract sites carry justified #pragma. Validated bit-identical against the
# real ggml-tiny + jfk.wav transcription. Per-call heap arrays here are a build warning from now on.
[Sources/Main/LanguageModels/Whisper/**.cs]
dotnet_diagnostic.OVERFIT001.severity = warning

# Audio/ ESCALATED 2026-06-16 after the OVERFIT001 sweep. FINDING: the audio hot paths were already
# zero-alloc — the per-frame STFT worker (MelSpectrogram.MelFrameWorker) is stackalloc/instance-buffer
# only, and the MP3 decoder reuses pre-allocated per-frame scratch. The 56 flagged sites were ALL
# correct-by-design: one-time (ctors, static decode tables), by-contract outputs (decoders/resamplers
# return a fresh array the caller owns), parity hooks, grow-only instance buffers, or eval metrics —
# each now carries a justified #pragma. Per-call heap arrays in core audio are a build warning from here.
[Sources/Main/Audio/**.cs]
dotnet_diagnostic.OVERFIT001.severity = warning

# Loading/ STAYS at suggestion — examined in the OVERFIT001 sweep (2026-06-17) and deliberately NOT
# escalated. The ~50 hits are ALL load-time-by-design: persistent model weights (DecodeWeight[] /
# weight float[] that live for the model's lifetime) and by-contract reads (loaded tensors + tokenizer
# metadata arrays the caller owns) — neither is poolable, and the genuine load scratch was already
# pooled in the peak-RAM work (e.g. GgufLlamaLoader.LoadRouter's PooledBuffer, GPT-2 lazy chunk stream).
# Loading is the load path, not a serving hot loop, so escalating would mean ~50 #pragmas for zero
# benefit. Kept as IDE suggestions; revisit only if a decode-hot path is ever added under Loading/.

# SNAC codec (Snac/) + Orpheus prompt/clone (Orpheus/) — carved back to suggestion like the CTC family.
# These are per-utterance (decode) / offline (encode, voice-clone dataset prep) correctness-first layered
# forwards, NOT a per-token serving hot loop (the class docs say so). Pooling their ~34 short-lived
# intermediate conv buffers would be invasive churn in a numerically-sensitive parity path for ~zero
# serving benefit. Kept visible as IDE suggestions; re-escalate if TTS latency is ever productised.
[Sources/Main/Audio/Tts/{Snac,Orpheus}/**.cs]
dotnet_diagnostic.OVERFIT001.severity = suggestion

# ── Generated code (obj/) — MUST stay the LAST section that overlaps *.cs ─────────────────────────────
# editorconfig applies the LAST matching section per key, so this wins RS0030 for obj/ files. It lives at
# the very end ON PURPOSE: an earlier placement (mid-file, right after the global RS0030 rule) silently
# scoped EVERY following diagnostic — CA2014, IDISP*, and all OVERFIT severities incl. OVERFIT008=error —
# to obj/ only, which demoted OVERFIT008 to its analyzer-default warning on real code and broke the
# analyzer-guard CI job. Keep new global [*.cs] rules ABOVE this block.
#
# The SDK AssemblyInfo / System.Text.Json JsonSerializerContext / GlobalUsings under obj/ are not ours and
# legitimately use System.Reflection, so scope the banned-API rule off for generated files (BannedApiAnalyzers
# 3.3.4 skipped them automatically; 5.6.0 analyses them). The STJ source-gen context itself is analysed under
# a synthetic path no section matches — that residual RS0030 warning is handled via <WarningsNotAsErrors> in
# Directory.Build.props. Real .cs code still gets RS0030 = error from the [*.cs] section at the top.
[**/obj/**]
dotnet_diagnostic.RS0030.severity = none

# OVERFIT021 (else) — Sources/Main is FULLY swept (322 -> 0), so the whole tree is the error scope.
# This replaced a hand-maintained directory list: ten already-clean directories (Diagnostics, Extensions,
# Licensing, Maths, Properties, Redaction, Runtime, Tokenization, Training, Trees) had been swept but never
# added to that list, so the ratchet silently did not hold for them. A whole-tree glob cannot drift.
#
# THREE gotchas, each of which silently produced a rule that looked configured but did nothing (all three
# were hit while wiring this up on 2026-07-18):
#   1. This section MUST stay at the END of the file. A [section] header scopes EVERY setting below it, so
#      placing it mid-file re-scoped OVERFIT011-020 + OVERFIT900 to these six directories only.
#   2. The glob must be `<dir>/**.cs`, NOT `<dir>/**/*.cs`. The latter requires an intermediate directory,
#      so it silently misses files sitting directly in <dir>.
#   3. The rule ID must NOT appear in <WarningsNotAsErrors> in Directory.Build.props. That maps to
#      -warnaserror-:ID, which reverts the diagnostic to warning EVEN WHERE .editorconfig sets error —
#      defeating this whole section. (This is why OVERFIT008/015 are absent from that list.)

# OVERFIT022 (recursion) — ERROR on the paths that parse untrusted, externally-authored input, where an
# uncatchable stack overflow would kill the embedding host. Existing bounded sites carry a #pragma naming
# their depth cap; this stops NEW unbounded recursion from entering these directories.
[Sources/Main/LanguageModels/{Loading,Constraints}/**.cs]
dotnet_diagnostic.OVERFIT022.severity = error

# OVERFIT021 (else) — Tests are the one exemption: test code is local and disposable, so the ban's rationale
# (shipped library, read by strangers, hot paths) does not apply. Kept at suggestion so it still shows in the
# IDE. MUST stay at the END of this file — a [section] header scopes every setting below it.
# OVERFIT030 — ERROR in the CLI too. HfDownloader was the whole backlog: five multi-gigabyte fetches
# that ignored Ctrl+C. Fixed properly rather than with an ignored parameter — the token reaches the socket
# and the file write, Console.CancelKeyPress signals it, and the swallowing catch blocks now rethrow
# OperationCanceledException so an interrupt cannot masquerade as "metadata unavailable, skipping
# verification". Interrupting is safe by construction: the .part temp is kept and the next run resumes it.
[Sources/Cli/**.cs]
dotnet_diagnostic.OVERFIT030.severity = error

[Tests/**.cs]
dotnet_diagnostic.OVERFIT021.severity = suggestion

# ── Library-only OVERFIT rules ─────────────────────────────────────────────────────────────
# These were designed for the SHIPPED library: zero-alloc hot paths (OVERFIT008/900), the CpuFeatures
# convention (015), and the NASA bounded-execution pair (022/023, whose rationale is "Overfit runs inside
# someone else's process"). Once the analyzer was wired into every project they also started firing in
# benchmarks and demos, where they are wrong by construction — Sources/Benchmark deliberately calls raw
# Parallel.For to A/B it against OverfitParallel, and OverfitParallelLegacy is a kept-for-comparison copy.
# So they are scoped to the library; OVERFIT021 (else) stays repo-wide because readability is not scoped.
[Sources/Main/**.cs]
dotnet_diagnostic.OVERFIT008.severity = error
dotnet_diagnostic.OVERFIT015.severity = error
dotnet_diagnostic.OVERFIT024.severity = warning
# OVERFIT025 — ERROR in the shipped library. Criteria met: the backlog is at ZERO (five cold-path buffers
# moved to PooledBuffer<T>, and Ops/ carries an explicit, scoped 4096 B budget for its activation tiles), the
# rule is unconditional, and the miss-cost is the worst there is — a StackOverflowException in Main kills the
# HOST process, uncatchable and unlogged. Same bar as OVERFIT008/015/022/023.
# NOT yet error: OVERFIT026 (40 open sites, see the ratchet note above) — several are genuinely unbounded,
# and pragma-ing them to reach `error` would rubber-stamp exactly what the rule exists to find.
dotnet_diagnostic.OVERFIT025.severity = error
# OVERFIT026 — ERROR in the library too. Every remaining site now carries a pragma naming its real
# bound, in the code, next to the allocation: an analyzer that only whispers gets ignored, and a
# deliberate exception belongs where the author signs it rather than in a directory-wide budget that
# would also wave through code nobody has looked at yet.
dotnet_diagnostic.OVERFIT026.severity = error
# OVERFIT028 — ERROR in the library. Backlog swept to zero: 68 sites widened mechanically with a (long)
# cast (free at runtime — imul r64 costs what imul r32 costs, and array creation already takes a 64-bit
# length), 3 rewritten by hand, 1 pragma'd where a 64-bit guard already proves the 32-bit product safe.
# Demo/ and Server keep the global suggestion.
dotnet_diagnostic.OVERFIT028.severity = error
# OVERFIT038 — ERROR in the library. Backlog swept to zero from 18 sites, and the inventory is the reason
# to trust the rule rather than its unit tests: 13 of them were three unvalidated header fields in
# CachedLlamaInferenceEngine.Load, which the 2026-08-02 HAND sweep that motivated this rule did not find —
# its window was a few lines and there the reads and their uses are thirty apart. 2 were LoRAWeight.Load
# feeding three file ints straight into a constructor that allocates on their product. Both now bound the
# declared shape against the bytes remaining, the house pattern. 1 is pragma'd in QwenTokenizer with the
# measurement that stops the obvious bound going in (real Qwen: 22 added tokens, highest id 151 664 against
# a 151 665 bound — a margin of one). 2 were the rule's own false positive, JsonElement.GetArrayLength,
# which reports a count the parser already materialised rather than one the file declares; fixed in the
# analyzer, not suppressed here.
dotnet_diagnostic.OVERFIT038.severity = error
# OVERFIT029 / OVERFIT030 (Async suffix / CancellationToken) — ERROR in the library, ZERO sites there.
# 029: the single real hit was CachedLlamaSession.StreamGenerate, renamed to StreamGenerateAsync (19
#      references, pre-1.0, so a rename beat a suppression).
# 030: Sources/Main already offers a token on every awaitable public method — the rule locks that in.
#      Sources/Cli keeps the suggestion: HfDownloader has 5 uncancellable downloads (a multi-GB fetch
#      that ignores Ctrl+C), and fixing that means wiring a real token, not adding an ignored parameter.
dotnet_diagnostic.OVERFIT029.severity = error
dotnet_diagnostic.OVERFIT030.severity = error

# OVERFIT031 (redundant async state machine) — ERROR in the library. The whole backlog was ONE site:
# LiveMonitoringPipeline.DisposeAsync, which disposed three resources synchronously and then awaited
# ValueTask.CompletedTask purely to justify the keyword. Fixed, so the rule starts at zero.
#
# The rule is deliberately narrow, because its one dangerous false positive would be severe: eliding inside a
# `using` returns the task before disposal and produces a use-after-dispose. It therefore stays silent on any
# body containing a using (either form) or a try, on more than one await, on an await that is not the tail,
# and on an awaited type that is not identical to the return type. Verified against 13 controls — 5 shapes it
# must catch and 8 it must not — because a rule that fires once across a solution looks the same whether the
# codebase is clean or the rule is broken.
dotnet_diagnostic.OVERFIT031.severity = error

# OVERFIT032 (await without ConfigureAwait(false)) — ERROR in the library. Coverage was already 17 of 19
# await sites, kept by hand; the two gaps were found by grepping rather than by anyone noticing, and one of
# them was real (OfflineTrainingJob's `await using` over the checkpoint stream). A convention that holds 89%
# of the time is a habit, and this is what a build error is for.
#
# A library does not choose its host: the same code awaited from the WPF demo or the Android app marshals
# every continuation through one dispatcher, and a caller that blocks deadlocks outright. Exempt by design:
# `await Task.Yield()` (YieldAwaitable has no such overload and always resumes on the captured context),
# anything already configured, and any awaitable with no ConfigureAwait member — reporting there would
# demand a fix that does not compile.
dotnet_diagnostic.OVERFIT032.severity = error

# OVERFIT027 — ERROR on the same criteria as OVERFIT008/015/025: ZERO existing sites in the whole
# solution at introduction (2026-07-24), unconditional rule, trivial fix (return Task), and the
# miss-cost is an uncatchable kill of the hosting process. A tripwire, not a sweep.
dotnet_diagnostic.OVERFIT027.severity = error
dotnet_diagnostic.OVERFIT022.severity = error
dotnet_diagnostic.OVERFIT023.severity = error
dotnet_diagnostic.OVERFIT900.severity = error

# ── OVERFIT040-045 — the async/readability set added 2026-08-11 ───────────────────────────────────────
#
# RATCHET, as OVERFIT021 and OVERFIT025/026 did before them. Backlog measured at introduction, whole
# solution / of which Sources:
#   OVERFIT040 (sync method with an async sibling)        184 / 142
#   OVERFIT041 (defaulted CancellationToken)               58 /  56
#   OVERFIT042 (index from end, x[^1])                     52 /  46
#   OVERFIT043 (range operator, x[1..])                   394 / 378
#   OVERFIT044 (null pattern, is null / is not null)      808 / 734
#   OVERFIT045 (primary constructor on class or struct)     8 /   4
#
# Those counts are grep-wide, and a severity set here does NOT reach all of them. The analyzer is wired
# centrally in Directory.Build.props:59-69 with an exclusion list, so it never runs in Analyzers, Tests,
# AotSmokeTest, Benchmarks, DevOnBike.Overfit.Templates or OverfitChat — measured 2026-08-11 by building
# Sources/Analyzers with 38 live OVERFIT044 sites in it and getting zero diagnostics. Two of those
# exclusions are decisions rather than gaps (test code is exempt from style rules; benchmarks deliberately
# write the slow shape next to the fast one), and Analyzers cannot ever be covered because it would
# reference itself. Read the "whole solution" column as the size of the READING preference and the Sources
# column as the size of what any escalation below can actually lock.
#
# 041, 042 and 045 are being swept to zero, after which they escalate here — they carry no severity line
# yet and sit at their default Warning until that sweep lands. 043 and 044 stay at suggestion while their
# backlog is worked down — 1202 sites between them, and a rule that cannot be obeyed today is a warning
# that trains people to ignore the channel, which is the failure the prerelease accept-list note in
# Directory.Build.targets describes.
#
# OVERFIT040 stays at suggestion globally and is raised only where threads are a scarce resource. In
# Sources/Main most of its hits are one-shot model and config loading, where synchronous IS correct: a
# GGUF reader is not improved by returning a task. Raising it there would make the rule lie.
#
# THE THREE SEVERITY LINES THAT USED TO SIT HERE HAVE MOVED to their own [*.cs] section near the end of
# this file. They were written here on 2026-08-11 and this section is [Sources/Main/**.cs], so the word
# "globally" three lines above was false for the whole day: outside Sources/Main all three ran at their
# DEFAULT severity, which is Warning. See that section for what it measured.

# ── OVERFIT046 — task discarded with `_ =`, added 2026-08-11 ──────────────────────────────────────────
#
# NOT part of the 040-045 set above and not a readability rule: it closes a MEASURED hole in CS4014, which
# Directory.Build.props promotes to error. CS4014 fires on `Work();` and is silent on `_ = Work();` —
# compiled both in one file, one diagnostic across the two. So a one-character edit opts out of a build
# error and nothing watched it.
#
# `error` is the intended end state and the reason it is NOT set here yet is a count, not a doubt. The rule
# was designed against 2 known sites; inventorying the whole tree before shipping found 6, because the first
# census covered Sources/ only and Demo is NOT on the exclusion list. It is now 5: Cli/GuardMetricsEndpoint
# was fixed while this rule was being written — it assigns the serve loop to a field instead of discarding
# it — which removed the one site that was a defect rather than a decision.
#
# The remaining 5 are Server.AspNet (1), Demo/LabLoadDriver (1), Demo/LabWorkload (3), and ALL FIVE are
# deliberate fire-and-forget that already observe their own exceptions: the load driver's SendAsync is
# wrapped end to end in a catch that counts the failure, and each LabWorkload body logs from a catch. So all
# five take a pragma naming the reason and NONE is better fixed. That leaves the rule with no live defect to
# catch, which is the OVERFIT027 posture — error at zero sites, as a tripwire on a shape that has already
# produced one real defect here.
#
# ALL FIVE PRAGMAS HAVE NOW LANDED (2026-08-11), so the rule is `error` — but the severity line is NOT here
# any more. THE LINE THAT USED TO SIT HERE WAS IN THE WRONG SECTION: this block is inside
# [Sources/Main/**.cs], and four of the rule's five sites are under Demo/. Outside the library the rule was
# therefore running at its ANALYZER DEFAULT, which is also Warning — so the configuration looked correct and
# was inert, and writing `error` here would have bound the library (zero sites) and left the four real ones
# at warning. Identical in kind to what the OVERFIT040/043/044 note at the end of this file describes.
# See the [*.cs] section near the end for the severity and what promoting it is worth.

# ── OVERFIT033 / OVERFIT034 — the two MSBuild guards, now analyzers ───────────────────────────────────
#
# Both replace RoslynCodeTaskFactory tasks that lived as embedded C# inside Main.csproj and Anomalies.csproj
# and matched with regular expressions over raw text. Moved on 2026-08-05 for three reasons, in order of
# weight: the regexes were wrong in both directions, embedded C# in XML has no tests and no IDE, and the
# same 40 lines had just been copy-pasted into a second csproj — which is the moment a copy becomes a
# maintenance problem rather than a shortcut.
#
# Both errors are now pinned by tests, and both are worth naming because they fail in opposite ways:
#   * the jagged check stripped only `//` comments, so `float[][]` inside a `/* ... */` comment was REPORTED
#     — an error about code that does not exist, which teaches people the rule is noise;
#   * the one-type check anchored on exactly four spaces of indentation, so under a file-scoped namespace it
#     matched nothing and REPORTED NOTHING, silently, for every such file.
# A guard that cries wolf and a guard that quietly stops are the same defect wearing different clothes.
#
# SCOPE IS DELIBERATELY UNCHANGED: error exactly where the MSBuild tasks used to fail the build, silent
# everywhere else. Making them warnings tree-wide would have turned a mechanical move into a sweep, and a
# refactor that also changes behaviour cannot be reverted cleanly if it goes wrong.
[*.cs]
dotnet_diagnostic.OVERFIT033.severity = none
dotnet_diagnostic.OVERFIT034.severity = none

[Sources/Main/**.cs]
dotnet_diagnostic.OVERFIT033.severity = error
dotnet_diagnostic.OVERFIT034.severity = error

[Sources/Anomalies/**.cs]
dotnet_diagnostic.OVERFIT033.severity = error
dotnet_diagnostic.OVERFIT034.severity = error

# ── Reliability rules, armed on the OTHER assemblies that parse external input ────────────────────────
# OVERFIT022/023/025/026/027/028/029/030 were error under [Sources/Main/**.cs] only. That scoping was never
# a decision — the Tests and Benchmarks exclusions are written down and argued, these four projects were
# simply not named. They take the same class of input the rules exist for: Anomalies parses Prometheus
# exposition text, Server.AspNet and Mcp parse HTTP bodies and JSON-RPC frames, Cli reads files chosen by
# whoever runs it. A stack overflow or an unbounded loop there kills the host process exactly as it would
# in the library.
#
# MEASURED BEFORE ARMING, 2026-08-10: the backlog across all four projects and all eight rules is ZERO, so
# this promotion costs nothing today and only binds what is written next. Two things had to be proved
# before that zero was worth anything, because the first two attempts to measure it were wrong:
#   * the rules RUN here — Directory.Build.props wires the analyzer into every project except
#     Analyzers/Tests/AotSmokeTest/Benchmarks and the templates. Confirmed with a probe file carrying a
#     `while (true)`: OVERFIT023 reported in Sources/Anomalies.
#   * six of the eight sit at `suggestion` under [*.cs] and A BUILD DOES NOT PRINT SUGGESTIONS. The first
#     sweep returned "0 sites" and was measuring the config's silence, not the code. Re-run with the
#     severities raised, and the raise itself proved by the same probe reporting OVERFIT026.
# The escape hatch is unchanged and is the point: a `#pragma warning disable` whose comment starts with
# `BOUND:` and names what bounds the loop, the recursion or the allocation. If that sentence cannot be
# written, the code is not safe and the pragma would be a lie.
[Sources/{Anomalies,Server.AspNet,Mcp,Cli}/**.cs]
dotnet_diagnostic.OVERFIT022.severity = error
dotnet_diagnostic.OVERFIT023.severity = error
dotnet_diagnostic.OVERFIT025.severity = error
dotnet_diagnostic.OVERFIT026.severity = error
dotnet_diagnostic.OVERFIT027.severity = error
dotnet_diagnostic.OVERFIT028.severity = error
dotnet_diagnostic.OVERFIT029.severity = error
dotnet_diagnostic.OVERFIT030.severity = error

# ── OVERFIT040 / 043 / 044 — the ratchet's severity, GLOBAL on purpose ────────────────────────────────
# The reasoning for these three lives with the 040-045 backlog table earlier in this file. Only the
# severities are here, and the placement is the whole point: they were written inside
# [Sources/Main/**.cs] on 2026-08-11 while their own prose said "stays at suggestion globally", so for
# one day the ratchet applied to the library and nowhere else.
#
# WHAT THAT COST, measured the same day by a deduplicated census over a whole-solution build: 60
# OVERFIT040 (Cli 15, Server.AspNet 12, Mcp 6, Demo 6, rest scattered), 16 OVERFIT044 and 2 OVERFIT043 —
# 78 of the tree's 115 analyzer warnings — were not a backlog anyone had chosen to carry. They were the
# rules running STRICTER outside the library than the decision that created them, because a severity
# written in a directory section is silent about every directory it does not name. Nothing reports this:
# the build is green either way and the prose reads as though it had been applied.
#
# This section is [*.cs] and sits after every directory section above, so it wins for Sources/Main too —
# which is what "globally" was always meant to say. Escalating any of the three later means moving its
# line into a directory section, deliberately, with the sweep that earns it.
[*.cs]
dotnet_diagnostic.OVERFIT040.severity = suggestion
dotnet_diagnostic.OVERFIT043.severity = suggestion
dotnet_diagnostic.OVERFIT044.severity = suggestion

# ── OVERFIT046 — task discarded with `_ =`. ERROR, and global for the same reason as the three above ──────
# The rule's own reasoning is in its block earlier in this file; only the severity is here, and the
# placement is the point: that block sits inside [Sources/Main/**.cs] and FOUR OF THE RULE'S FIVE SITES ARE
# UNDER Demo/. A severity written there binds the library and is silent about every directory it does not
# name. This section is [*.cs] and comes after every directory section above, so it wins everywhere.
#
# WHAT PROMOTING IT IS WORTH, stated plainly because the honest version is unflattering: THE RULE SHIPS WITH
# ZERO LIVE DEFECTS TO CATCH. Its one true positive — Cli/GuardMetricsEndpoint, whose serve loop died
# silently on any non-transport exception — was fixed by someone else the same day, and its remaining four
# reports are all correct fire-and-forget that already observe their own exceptions. Each now carries a
# pragma naming what makes the discard safe AND what is given up (2026-08-11: LabWorkload's three
# fault-injection endpoints and LabLoadDriver's paced send).
#
# So this is a TRIPWIRE ON A SHAPE THAT HAS ALREADY PRODUCED ONE REAL DEFECT HERE, exactly like OVERFIT027
# at zero sites — NOT a cleanup tool. It buys one thing: `_ = SomethingAsync()` can no longer be written by
# accident to get past CS4014, which Directory.Build.props promotes to error and which is silent on the
# discard. Every future one has to be signed.
dotnet_diagnostic.OVERFIT046.severity = error

# ── Source-generated files, by name ───────────────────────────────────────────────────────────────────
# The System.Text.Json source generator emits its context under a path the [**/obj/**] section does not
# match, so RS0030 fell through to its default Warning there. Directory.Build.props used to handle that by
# exempting RS0030 from TreatWarningsAsErrors globally — which ALSO downgraded it on real code, measured
# 2026-08-08: three System.Reflection sites and one banned Array.Copy sat as warnings in Sources/Main while
# both files asserted in comments that this could not happen. Scoping by filename is narrow enough to leave
# the ban armed everywhere it matters.
[*.g.cs]
dotnet_diagnostic.RS0030.severity = none
