<Project>
    <PropertyGroup>
        <Version>10.1.1</Version>
        <FileVersion>10.1.1</FileVersion>

        <!-- The last version actually ON nuget.org, which is NOT the same thing as `Version` above and is
             the only correct anchor for anything that must reference a published package — today just
             `Templates/content/OverfitChat`, whose content may not point into this repository at all.
             Added 2026-08-14 after the template was found pinned at 10.0.29 while nuget held 10.0.31 and
             this file said 10.1.0: a checker anchored on `Version` would have bumped the template to an
             unpublished package and broken `dotnet new overfit-chat` on first restore.
             UPDATE THIS WHEN YOU PUBLISH, in the same commit that stamps the CHANGELOG.
             `Scripts/check_template_pins.py` reads it; it is not consumed by any build. -->
        <LastPublishedVersion>10.1.0</LastPublishedVersion>
        <InformationalVersion>release+id</InformationalVersion>
        <Authors>DevOnBike</Authors>
        <Company>Sharp IT</Company>
        <Product>Overfit</Product>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904;CS4014</WarningsAsErrors>

        <!-- The project's OWN advisory analyzers are NOT Native-AOT-safety signals: OVERFIT* are perf-style
             suggestions (per-call allocs, string-building, etc.) and IDISP* are disposable-hygiene style
             warnings. The `aot-guard` CI job publishes under TreatWarningsAsErrors=true so that the framework's
             IL2026 / IL3050 / IL31xx trim/AOT warnings become hard errors — but that blunt switch would also
             promote ~1000 OVERFIT suggestions + the IDISP warnings to errors and fail the guard for reasons
             unrelated to AOT. Exempting them here (a no-op for normal builds, which don't treat warnings as
             errors) keeps ONLY the IL* trim/AOT diagnostics fatal under the guard. OVERFIT008 / OVERFIT015 are
             deliberately omitted — they are error-severity hard conventions and must stay fatal (the
             analyzer-guard CI job's tripwire depends on OVERFIT008 firing).
             RS0030 IS NOT IN THIS LIST, and must not be added — a long paragraph here used to explain why it
             was, and outlived the entry by describing a state that had not been true for some time. What it
             described is real and is a different problem: .editorconfig severities are matched per syntax
             tree against the csc command line, so no section reaches a SOURCE-GENERATED tree and RS0030
             falls back to its analyzer default Warning there, which TreatWarningsAsErrors promotes. Putting
             the id here does fix that — and, per the note immediately below, ALSO disarms the ban on real
             code, which is the 2026-08-08 incident that must not be repeated. The correct instrument is a
             per-project global AnalyzerConfig, which the compiler consults only for the trees the per-path
             map misses: see Sources/Anomalies/SourceGenerated.globalconfig, added 2026-08-16 for the
             configuration-binder generator, which carries the measurement and the two-arm proof. -->
        <!-- Do NOT add an ID here that .editorconfig promotes to `error` anywhere: this maps to
             -warnaserror-:ID, which reverts the diagnostic to warning EVEN in directories where
             .editorconfig says error, silently neutering the per-directory ratchet. Measured 2026-07-19:
             OVERFIT001/002/009 (error in Kernels+Intrinsics) and OVERFIT900 (error repo-wide) were all
             inert for this reason; removing them from this list cost 0 new errors. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);OVERFIT003;OVERFIT004;OVERFIT005;OVERFIT006;OVERFIT007;OVERFIT010;OVERFIT011;OVERFIT012;OVERFIT013;OVERFIT014;OVERFIT016;OVERFIT017;OVERFIT018;OVERFIT019;OVERFIT020;IDISP001;IDISP002;IDISP003;IDISP004;IDISP005;IDISP006;IDISP007;IDISP008;IDISP009;IDISP010;IDISP011;IDISP012;IDISP013;IDISP014;IDISP015;IDISP016;IDISP017</WarningsNotAsErrors>

    </PropertyGroup>

    <!--
        In-repo Roslyn analyzers (OVERFIT001+ per-call perf rules, OVERFIT021 else-ban, OVERFIT022 recursion,
        OVERFIT023 unbounded loops) wired CENTRALLY so every project is covered and a NEW project inherits them
        automatically. This used to live per-project in Main.csproj; a hand-maintained list drifts exactly the
        way the .editorconfig directory list did (ten already-clean directories were silently never locked).

        Wired as an ANALYZER, not a library reference — it runs inside the compiler and ships nothing.
        NOTE: command-line -p: globals (PublishAot, RID...) flow through the whole graph; the analyzer project
        shields itself via TreatAsLocalProperty in Analyzers.csproj (GlobalPropertiesToRemove on the reference
        was tried and does NOT survive restore).

        Excluded, each for a concrete reason:
          Analyzers                   - would reference itself.
          Tests / AotSmokeTest        - test code is exempt from the style rules by decision; AotSmokeTest also
                                        publishes under TreatWarningsAsErrors, so extra analyzers there would
                                        make the AOT guard fail for non-AOT reasons.
          Templates + OverfitChat     - `dotnet new` template content must reference ONLY published NuGet
                                        packages; a path into this repo would not exist in a scaffolded app.
          Benchmarks                  - benchmark code deliberately writes the SLOW shape next to the fast one
                                        (raw Parallel.For vs OverfitParallel, `else` vs guard clauses). The
                                        rules would flag the very thing being measured.
    -->
    <ItemGroup Condition="
        '$(MSBuildProjectName)' != 'Analyzers' AND
        '$(MSBuildProjectName)' != 'Tests' AND
        '$(MSBuildProjectName)' != 'AotSmokeTest' AND
        '$(MSBuildProjectName)' != 'Benchmarks' AND
        '$(MSBuildProjectName)' != 'DevOnBike.Overfit.Templates' AND
        '$(MSBuildProjectName)' != 'OverfitChat'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)Sources\Analyzers\Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
</Project>