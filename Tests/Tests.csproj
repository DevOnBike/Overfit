<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- xunit v3 ships its own test host, so the project is an executable rather than a
	     library discovered by VSTest. Without this the assembly builds and no test runs. -->
		<OutputType>Exe</OutputType>
		<Nullable>annotations</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>DevOnBike.Overfit.Tests</RootNamespace>
		<AssemblyName>DevOnBike.Overfit.Tests</AssemblyName>
		<SonarQubeExclude>true</SonarQubeExclude>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<!--Thread_UseAllCpuGroups>true</Thread_UseAllCpuGroups-->
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" />
		<PackageReference Include="Moq" />
		<PackageReference Include="System.Numerics.Tensors" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Sources\Main\Main.csproj" />
		<ProjectReference Include="..\Sources\Extensions.AI\Extensions.AI.csproj" />
		<ProjectReference Include="..\Sources\Mcp\Mcp.csproj" />
		<ProjectReference Include="..\Sources\Server\Server.csproj" />
		<ProjectReference Include="..\Sources\Server.AspNet\Server.AspNet.csproj" />
		<ProjectReference Include="..\Sources\Anomalies\Anomalies.csproj" />
		<!--
		  The only Demo project this test assembly references, and it earns it. On 2026-08-11 the demo stopped
		  getting its Prometheus exposition from OpenTelemetry.Exporter.Prometheus.AspNetCore — four years in
		  prerelease, never a stable release, and the repository's only prerelease pin — and now writes the text
		  itself, the way Sources/Server.AspNet and Sources/Anomalies already do. That swapped a package for
		  real logic: cumulative buckets, label escaping, one HELP/TYPE pair per metric. A document that breaks
		  any of those is REJECTED BY PROMETHEUS and looks perfectly fine from the outside, which is the class
		  of failure this repository does not leave untested.
		-->
		<ProjectReference Include="..\Demo\LocalAgentAspNetDemo\LocalAgent.AspNet.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="test_fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- AotSmokeTest is its own AOT-publish exe project living under Tests/; exclude its sources from this
	     xUnit project's default glob so its entry point (Program.cs) isn't compiled in twice. -->
	<ItemGroup>
		<Compile Remove="AotSmokeTest\**\*.cs" />
		<None Remove="AotSmokeTest\**\*" />
	</ItemGroup>


	<!--
	  The analyzer project as a LIBRARY reference, not as an analyzer. Directory.Build.props deliberately
	  excludes Tests from the analyzer wiring (test code is exempt from the style rules), which is exactly
	  what makes this possible: the assembly can be referenced and its analyzers instantiated by hand, with
	  no duplicate-item conflict and without OVERFIT rules being enforced on the tests themselves.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Sources\Analyzers\Analyzers.csproj" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
	</ItemGroup>
</Project>
