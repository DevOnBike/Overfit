{
  "_provenance": "Measured floors from the running lab, rescued 2026-08-08 from Tests/bin/lab-guard.json, which is gitignored ([Bb]in/) and purged by cleanup.cmd \u2014 it was the ONLY copy. Every threshold here was calibrated on this population; none came from literature. The two sibling configs (guard.lab.json, guard.lab-workload.json) carry NO thresholds at all, and guard.lab.json additionally targets the superseded overfit-server deployment. Reconciling the three is an open decision, not done here.",
  "prometheus": "http://overfit-lab-prometheus.monitoring.svc.cluster.local:9090",
  "namespace": "lab",
  "workload": "lab-workload",
  "podRegex": "lab-workload-.*",
  "metrics": {
    "RequestsPerSecond": {
      "source": "labapp_requests_total",
      "kind": "Counter"
    },
    "ErrorRate": {
      "source": "labapp_errors_total",
      "kind": "Counter"
    },
    "LatencyP50Ms": {
      "source": "labapp_request_duration_seconds",
      "kind": "HistogramSeconds",
      "quantile": 0.5
    },
    "LatencyP95Ms": {
      "source": "labapp_request_duration_seconds",
      "kind": "HistogramSeconds",
      "quantile": 0.95
    },
    "LatencyP99Ms": {
      "source": "labapp_request_duration_seconds",
      "kind": "HistogramSeconds",
      "quantile": 0.99
    },
    "CpuUsageRatio": {
      "source": "container_cpu_usage_seconds_total",
      "kind": "Counter"
    },
    "MemoryWorkingSetBytes": {
      "source": "container_memory_working_set_bytes",
      "kind": "Gauge"
    },
    "GcGen2HeapBytes": {
      "source": "dotnet_gc_heap_size_bytes",
      "kind": "Gauge"
    },
    "GcPauseRatio": {
      "source": "dotnet_gc_pause_seconds_total",
      "kind": "Counter"
    },
    "ThreadPoolQueueLength": {
      "source": "dotnet_threadpool_queue_length",
      "kind": "Gauge"
    },
    "OomEventsRate": {
      "source": "container_oom_events_total",
      "kind": "EventCount"
    },
    "ContainerRestarts": {
      "source": "kube_pod_container_status_restarts_total",
      "kind": "EventCount"
    }
  },
  "thresholds": {
    "CpuUsageRatio": {
      "minGap": "0.00041",
      "minTrendChange": "0.000326"
    },
    "MemoryWorkingSetBytes": {
      "minGap": "9.52MB",
      "minTrendChange": "25.85MB"
    },
    "GcGen2HeapBytes": {
      "minGap": "0.93MB",
      "minTrendChange": "3.93MB"
    },
    "RequestsPerSecond": {
      "minGap": "0.0238",
      "minTrendChange": "0.333"
    },
    "GcPauseRatio": {
      "minGap": "0.0000209"
    },
    "LatencyP50Ms": {
      "minTrendChange": "50"
    },
    "LatencyP95Ms": {
      "minTrendChange": "50"
    },
    "LatencyP99Ms": {
      "minTrendChange": "50"
    },
    "ErrorRate": {
      "minGap": "0.01",
      "minTrendChange": "0.01"
    }
  }
}
