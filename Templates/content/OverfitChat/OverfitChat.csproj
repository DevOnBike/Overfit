<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Overfit runtime (pure .NET, in-process) + its Microsoft.Extensions.AI adapter, and the
         Microsoft.Extensions.AI DI package that gives you AddChatClient(...). No Ollama, no Docker. -->
    <PackageReference Include="DevOnBike.Overfit" Version="10.0.29" />
    <PackageReference Include="DevOnBike.Overfit.Extensions.AI" Version="10.0.29" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
  </ItemGroup>

</Project>
