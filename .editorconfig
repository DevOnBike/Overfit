root = true

[*.cs]
dotnet_diagnostic.RS0030.severity = error
dotnet_diagnostic.CA2014.severity = error
dotnet_diagnostic.IDE0073.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.SA1202.severity = warning
dotnet_diagnostic.SA1600.severity = none
# IDisposableAnalyzers (IDISP*) — a full 133-site audit (2026-06-21) classified every warning as either a
# SYSTEMATIC false-positive of this codebase's deliberate ownership models, or a genuine bug. The genuine ones
# (3: SequentialTrainingBackend disposing only via Reset, LSTMLayer + ScaledDotProductAttention pooled-storage
# leaks) were FIXED in code. The remaining ~130 are structural false-positives the analyzer cannot see through:
#   • OWNERSHIP-TRANSFER — a factory/loader creates a disposable (GgufReader stream, engine weights + mmap,
#     SentenceEmbedder encoder, pipeline-stage tensors) and hands it to a type that then owns + disposes it
#     (drives IDISP008/007/001/003). Documented hand-offs (SlmRuntimeHandle, GptAnomalyDetector, the Data/Prepare
#     pipeline) dispose exactly what they own.
#   • AUTOGRAD-GRAPH OWNERSHIP — `graph.X()` nodes are reclaimed by `graph.Reset()` via an ownership tag, so a
#     "created, not disposed" AutogradNode is correct (drives IDISP001/003).
#   • JSON-ENUMERATOR STRUCTS — `JsonElement.EnumerateObject/Array()` returns a struct enumerator `foreach`
#     disposes automatically (drives IDISP004).
# Restructuring does NOT silence them — AutogradNode already uses the textbook `_ownsDataStorage` flag and STILL
# trips IDISP008. Demoting to suggestion keeps the IDE hint for genuinely-new ambiguous cases while removing the
# build noise that otherwise trains everyone to ignore the rule (and the real leaks with it).
# Only the rules below are STRUCTURALLY impossible to satisfy with correct code under our two ownership
# models (proven above). Every rule that CAN be satisfied was fixed in code and stays armed at its default
# severity: IDISP006 (Adam.ParamState now implements IDisposable and owns its M/V moment buffers) and the
# three genuine leaks (SequentialTrainingBackend Reset→Dispose, LSTMLayer + ScaledDotProductAttention pooled
# storage) were FIXED, not demoted.
dotnet_diagnostic.IDISP001.severity = suggestion
dotnet_diagnostic.IDISP002.severity = suggestion
dotnet_diagnostic.IDISP003.severity = suggestion
dotnet_diagnostic.IDISP004.severity = suggestion
dotnet_diagnostic.IDISP007.severity = suggestion
dotnet_diagnostic.IDISP008.severity = suggestion
dotnet_diagnostic.IDISP015.severity = suggestion

csharp_blank_lines_after_using_list = 1
csharp_blank_lines_after_file_scoped_namespace_directive = 1
csharp_style_namespace_declarations = block_scoped:warning

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_prefer_braces = true:warning

# Fully-expanded Allman: brace on its own line after if/else/for/etc., and never collapse a block or its
# body onto one line — so `if (u <= cumulative) { return i; }` is reformatted to the brace-on-newline,
# body-on-newline, closing-brace-on-newline form. Enforced by IDE0055 (=warning above) and auto-applied
# by `dotnet format` / update-code-headers.cmd.
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

csharp_space_around_binary_operators = before_and_after

file_header_template = Copyright (c) 2026 DevOnBike.\nThis file is part of DevonBike Overfit.\nDevonBike Overfit is licensed under the GNU AGPLv3.\nFor commercial licensing options, contact: devonbike@gmail.com
# ── Overfit custom performance analyzer (Sources/Analyzers) — RATCHET rollout ──────────────
# OVERFIT001 (per-call heap array allocation → PooledBuffer<T>/PooledArray/TensorStorage<T>/
# stackalloc): IDE suggestion everywhere; build WARNING in the zero-alloc hot directories.
# Policy: clean a directory → flip it to warning below. Never loosen a flipped directory.
# Backlog at introduction (2026-06-11): 432 unique sites; Runtime 85 (mostly batched-prefill,
# actionable), Loading 60, Audio/Tts 38, Whisper 33 — flip those as they get swept.
dotnet_diagnostic.OVERFIT001.severity = suggestion
dotnet_diagnostic.OVERFIT002.severity = suggestion
dotnet_diagnostic.OVERFIT003.severity = suggestion
dotnet_diagnostic.OVERFIT004.severity = suggestion
dotnet_diagnostic.OVERFIT005.severity = suggestion
dotnet_diagnostic.OVERFIT006.severity = suggestion
dotnet_diagnostic.OVERFIT007.severity = suggestion
# PROMOTED TO ERROR (criteria: zero existing sites + unconditional rule + trivial fix/pragma + high miss-cost):
# OVERFIT008 — a suppress leak silently breaks data-parallel training (measured 1.8x); like RS0030.
# OVERFIT015 — CpuFeatures gating is a hard convention; the fix is a one-token change.
# (moved to the [Sources/Main/**.cs] section at the end of this file)
# (moved to the [Sources/Main/**.cs] section at the end of this file)
dotnet_diagnostic.OVERFIT009.severity = suggestion
# Tier A, added 2026-06-13 — start on the bottom rung (suggestion everywhere). Escalate a directory
# once it is swept, exactly like 001-009. 010 (growable collections) and 014 (ToLower compare) are
# allocation rules; 011 (struct dict key), 012 (finalizer), 013 (concurrent .Count) are convention rules.
dotnet_diagnostic.OVERFIT010.severity = suggestion

# ── OVERFIT021 (else / else if) — RATCHET rollout ──────────────────────────────────────────
# Readability rule, not perf: prefer a guard clause + early return, `continue` in loops, a ternary,
# or a switch expression. Introduced 2026-07-18 against 321 existing occurrences in 124 files, so a
# blanket `error` was not an option — it would have forced one mechanical rewrite across the whole
# library including hot inference paths, which is precisely the unmeasured behaviour-preserving
# refactor this repo forbids. The sweep is now COMPLETE (322 -> 0 in Sources/Main, and every other project
# except Tests), so the rule is ERROR repo-wide. Tests are exempted at the END of this file: test code is
# throwaway and local, and the argument for the ban (shipped library, read by strangers, hot paths) does not
# apply there. Sources/Benchmark/ElseRefactorBenchmark.cs keeps its `else` behind a #pragma — those forms are
# the measurement subject that justifies the rule.
# Backlog at introduction: LanguageModels 163, Audio 35, Ops 34, Data 13, Onnx 14, DeepLearning 12.
dotnet_diagnostic.OVERFIT021.severity = error

# OVERFIT022 (direct recursion) — NASA Power of 10 rule 1. ERROR EVERYWHERE, deliberately: a .NET
# StackOverflowException cannot be caught, so unbounded recursion is an uncatchable kill of the HOST
# application, and Overfit's whole premise is running inside someone else's process. Every recursive site
# in Sources/Main therefore carries an explicit `#pragma warning disable OVERFIT022` whose comment states
# the BOUND that makes it safe (a checked depth cap, or a structural log2(n) argument). If you cannot write
# that sentence, the recursion is not safe and needs an explicit stack/worklist instead.
# (moved to the [Sources/Main/**.cs] section at the end of this file)

# OVERFIT023 (loop with no exit condition in its header) — NASA Power of 10 rule 2. ERROR EVERYWHERE, same
# contract as OVERFIT022: an unbounded loop hangs the HOST process with no exception, no stack trace and no
# log line, which is the hardest failure of all to diagnose. Every `while (true)` in Sources/Main carries a
# `#pragma warning disable OVERFIT023` whose comment starts with "BOUND:" and names what terminates it.
# (moved to the [Sources/Main/**.cs] section at the end of this file)


dotnet_diagnostic.OVERFIT011.severity = suggestion
dotnet_diagnostic.OVERFIT012.severity = suggestion
dotnet_diagnostic.OVERFIT013.severity = suggestion
dotnet_diagnostic.OVERFIT014.severity = suggestion
# Tier B, added 2026-06-13 — HEURISTIC, advisory-only. Stay suggestion EVERYWHERE and do NOT escalate
# under [OverfitHotPath] (they don't route through OverfitPerfAnalysis.Report) — a heuristic false
# positive must never break a build. 016 large-struct-by-value, 017 could-be-readonly-struct,
# 018 readonly-field-of-mutable-struct (#90 trap), 019 non-capturing-lambda-without-static.
dotnet_diagnostic.OVERFIT016.severity = suggestion
dotnet_diagnostic.OVERFIT017.severity = suggestion
dotnet_diagnostic.OVERFIT018.severity = suggestion
dotnet_diagnostic.OVERFIT019.severity = suggestion
# OVERFIT020 — array param could be (ReadOnly)Span<T>. Advisory like the rest of Tier B; suggestion-
# only, does not escalate. Fires only when the array provably does not escape (no field/return/array-arg/
# capture; ordinary private/internal non-async non-iterator methods) so it never suggests breaking a
# stored-weights API. An API-shape change a human reviews, never a build gate.
dotnet_diagnostic.OVERFIT020.severity = suggestion
# OVERFIT025 (stackalloc over the byte budget) / OVERFIT026 (stackalloc with a variable element count).
#
# WHY AT ALL: nothing in the shipped analyzer set bounds stackalloc SIZE — CA2014 only catches allocation
# inside a loop. Yet size is the failure that matters in a hosted library: StackOverflowException cannot be
# caught, cannot be logged, and takes the whole process down, on threads whose stack size we do not choose.
#
# BUDGET = 512 BYTES OF MEMORY, never element count: the rule multiplies length by element width, so
# char[256], int[128], double[64] and Vector256<float>[16] all sit exactly at the limit and are treated
# alike. An element-count rule would wave through Vector512<T>[64] (4 KB) while stopping byte[300].
#
# Reference points: Microsoft's stackalloc documentation uses `const int MaxStackLimit = 1024;` as its
# worked example and instructs "be conservative when you define the actual limit value"; the BCL is
# stricter than its own page, with StackallocCharBufferSizeLimit = 256 chars and
# StackallocIntBufferSizeLimit = 128 ints — 512 B each — in System.String's manipulation paths. So 512 B is
# the BCL's working figure, and a census of Sources/Main (2026-07-24) says it cuts in the right place: of
# 63 constant-size sites, 49 are <= 512 B (48 of them <= 256 B, plus exactly one int[128] matching the BCL
# limit to the element) and NOTHING sits between 512 B and 1 KB. Everything above that gap is a deliberate
# tile/block buffer, so any threshold in 512..1024 B flags the same 14 sites.
#
# Per-directory override: `overfit_max_stackalloc_bytes = N`. A kernel that MEASURED its way to a bigger
# buffer raises its own budget and states why — it does not raise the tree's.
#
# OVERFIT026: a VARIABLE element count is not allowed. `stackalloc T[n]` with non-constant n defeats the
# byte budget entirely — the cost cannot be read off the line, so neither the rule nor a reviewer can bound
# it. Live example in this tree: `stackalloc float[vocab]` is ~608 KB on a 152k-token vocabulary, over half
# a default thread stack, in one call. The documented `n <= Limit ? stackalloc T[n] : new T[n]` guard is
# reported too, deliberately: a guard is only as good as the constant it compares against and the direction
# of the comparison, neither of which a mechanical check can confirm. Opt out per site with
# `#pragma warning disable OVERFIT026` whose comment names what bounds the length — the same visible,
# reviewable contract as OVERFIT022/023.
#
# RATCHET: both start at suggestion everywhere, as OVERFIT021 did. Backlog measured 2026-07-24 —
#   OVERFIT025: 15 sites. Ops/TensorMath.{Gelu,SiLU,Activations} 4 KB tiles, SafetensorsReader 4 KB
#     chunks, Q4K/Q6KRepack block buffers (1152/1680 B).
#   OVERFIT026: 41 sites. Q4K/Q6KGemvKernel vector scratch, TrainableLlamaModel float[vocab] (~608 KB on a
#     152k vocabulary — the worst one in the tree), MelSpectrogram, GgufReader, CachedLlamaSession,
#     WhisperKernels, VectorizedRandom, CholeskyMultivariateGaussianLogic, LoRAWeight, FeatureExtractor.
#     14 of these were previously invisible: they use the documented ternary guard, which this rule reports
#     on purpose rather than blessing.
# Escalate Sources/Main to warning once a list is at zero or each survivor carries a pragma with its bound.
#
# FIRST SWEEP ENTRY, and the pattern for the rest: Statistics/MannWhitneyU's radix digit histogram was
# 8 KB of stackalloc, defended on the grounds that it is touched 8x per element and belongs in L1. A/B
# against the identical buffer rented from the pool measured 1.006x / 0.992x / 1.025x at 500 / 2 000 /
# 10 000 samples per arm — a tie wherever the code actually runs. The argument did not survive measurement,
# so the site moved to PooledBuffer<int> rather than buying itself an exemption.
dotnet_diagnostic.OVERFIT025.severity = suggestion
# OVERFIT027 (async void) — suggestion outside the library so a WPF/demo event handler is a hint, not a
# wall; ERROR in Sources/Main below.
dotnet_diagnostic.OVERFIT027.severity = suggestion
dotnet_diagnostic.OVERFIT028.severity = suggestion
dotnet_diagnostic.OVERFIT029.severity = suggestion
dotnet_diagnostic.OVERFIT030.severity = suggestion

# OVERFIT038 (externally-read count sizing an allocation or bounding a loop) — warning while the backlog is
# swept, error in the library below. Held at warning outside Sources/Main because tests and demos read files
# they wrote themselves, where the count is not an attacker's.
dotnet_diagnostic.OVERFIT038.severity = warning

# OVERFIT031 (redundant async state machine) — suggestion outside the library. Eliding changes when a
# pre-await exception surfaces (synchronously, rather than inside the returned task), which is invisible to
# a caller that awaits immediately and visible to one that stores the task. Outside Sources/Main that call
# shape is not ours to police.
dotnet_diagnostic.OVERFIT031.severity = suggestion

# OVERFIT032 (await without ConfigureAwait(false)) — suggestion outside the library. Applications and the
# analyzer project pick their own host and have no synchronization context to capture, so the rule buys them
# nothing; Cli has 22 sites and Server.AspNet 4, none of which can deadlock.
dotnet_diagnostic.OVERFIT032.severity = suggestion

dotnet_diagnostic.OVERFIT026.severity = suggestion
# OVERFIT900 — the [OverfitHotPath] escalation. Any per-call rule (001-007, 009-011, 013-014) that
# fires inside a member or type marked [DevOnBike.Overfit.Diagnostics.OverfitHotPath] is reported as
# this hard error INSTEAD of its directory-configured severity — the per-member ratchet. Always error;
# never loosen it (that would defeat the marker). Suppress a justified site with #pragma + a reason.
# (moved to the [Sources/Main/**.cs] section at the end of this file)

[Sources/Main/Kernels/**.cs]
# Allocation rules are ERRORS in pure kernels — per-call allocation is never right here;
# a justified exception is an explicit #pragma with the reason.
dotnet_diagnostic.OVERFIT001.severity = error
dotnet_diagnostic.OVERFIT002.severity = error
dotnet_diagnostic.OVERFIT003.severity = warning
dotnet_diagnostic.OVERFIT004.severity = warning
dotnet_diagnostic.OVERFIT005.severity = warning
dotnet_diagnostic.OVERFIT006.severity = warning
dotnet_diagnostic.OVERFIT007.severity = warning
dotnet_diagnostic.OVERFIT009.severity = error

[Sources/Main/Intrinsics/**.cs]
# Allocation rules are ERRORS in pure kernels — per-call allocation is never right here;
# a justified exception is an explicit #pragma with the reason.
dotnet_diagnostic.OVERFIT001.severity = error
dotnet_diagnostic.OVERFIT002.severity = error
dotnet_diagnostic.OVERFIT003.severity = warning
dotnet_diagnostic.OVERFIT004.severity = warning
dotnet_diagnostic.OVERFIT005.severity = warning
dotnet_diagnostic.OVERFIT006.severity = warning
dotnet_diagnostic.OVERFIT007.severity = warning
dotnet_diagnostic.OVERFIT009.severity = error

[Sources/Main/Ops/**.cs]
