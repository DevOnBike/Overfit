<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DebugType>embedded</DebugType>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<RootNamespace>DevOnBike.Overfit</RootNamespace>
		<AssemblyName>DevOnBike.Overfit</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<SourceRevisionId>N/A</SourceRevisionId>
		<InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>
		<PackageId>DevOnBike.Overfit</PackageId>
		<Authors>DevOnBike</Authors>
		<Copyright>Copyright (c) 2026 DevOnBike</Copyright>
		<Description>Pure-C# in-process LLM and deep-learning runtime for .NET 10. Loads GGUF / HF safetensors / ONNX directly (Qwen, Llama, Mistral, Mixtral, MoE, BERT-family embeddings). Zero-allocation CPU inference, Native AOT-compatible, no Python, no native dependencies, no exposed server. Dual-licensed: AGPL-3.0-or-later for open source, commercial license available — see COMMERCIAL.md.</Description>
		<PackageTags>llm;qwen;llama;mistral;gguf;onnx;embeddings;rag;agentic;tool-calling;machine-learning;deep-learning;native-aot;zero-allocation;simd;tensor;ai;csharp;in-process</PackageTags>
		<RepositoryUrl>https://github.com/DevOnBike/Overfit</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<!-- Dual-licensed: AGPL-3.0-or-later for OSS use, Commercial license available for closed-source / SaaS / regulated use.
             PackageLicenseFile (not PackageLicenseExpression) is used because SPDX expressions cannot describe a custom dual-license
             arrangement; the full text — both AGPLv3 terms and the commercial alternative — lives in LICENSE.md. -->
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>logo.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!-- Debug symbols are embedded in the dll (DebugType=embedded above), so do NOT emit a separate symbol
             package — IncludeSymbols=true would produce a legacy *.symbols.nupkg with no pdb to carry. -->

		<PublishAot>true</PublishAot>
		<IsAotCompatible>true</IsAotCompatible>
		<OptimizationPreference>Speed</OptimizationPreference>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="logo.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
		<None Include="..\..\COMMERCIAL.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="DevOnBike.Overfit.Tests" />
		<InternalsVisibleTo Include="Benchmarks" />
		<!--
          The anomaly guard was split out of this project on 2026-08-05 and reaches back for exactly ONE
          internal: MedianSelector, a statistical primitive it uses in the threshold rules. One type across a
          120-file move is the measurement that says the seam was in the right place — if this list grows,
          the thing being reached for probably belongs in Main's public surface or in the guard itself.
        -->
		<InternalsVisibleTo Include="DevOnBike.Overfit.Anomalies" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IDisposableAnalyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Numerics.Tensors" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="BannedSymbols.txt" />
		<Using Remove="System.Linq" />
		<!-- Overfit's exception hierarchy is available everywhere in Main (it replaces the BCL domain
             exceptions at throw sites) without a per-file using. -->
		<Using Include="DevOnBike.Overfit.Exceptions" />
	</ItemGroup>

	<!--
        The two source-file guards that used to live here — BanJaggedFloatArrays (OVERFIT-JAGGED) and
        BanMultipleTopLevelTypes (OVERFIT-ONETYPE) — left this file on 2026-08-05. They are Roslyn analyzers
        now, OVERFIT033 and OVERFIT034, with their severity set per directory in .editorconfig exactly where
        these used to fail the build.

        Not merely tidying. Both matched with regular expressions over raw text and both had holes a syntax
        tree does not: a block comment on a code line hid a `float[][]`, and the one-type rule required
        exactly four spaces of indentation, so it would have stopped applying to the first file-scoped
        namespace anybody wrote. The trigger was the second copy — splitting the anomaly guard into its own
        project duplicated these forty lines into a second csproj, which is the moment a copy stops being a
        shortcut and becomes two things to keep in step.

        EmbedJsonSchemas below has NOT moved yet. It is codegen rather than a rule, so its proper home is an
        incremental source generator, and that is a different piece of work from turning two guards into
        analyzers. Tracked rather than quietly left.
    -->

	<!-- Codegen: every **/Schemas/*.json becomes a const on OverfitSchemas (see JudgeSchema's doc comment for
         why this is codegen and not an <EmbeddedResource>). -->
	<UsingTask TaskName="EmbedJsonSchemas" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Schemas ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.Collections.Generic" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Text" />
			<Code Type="Fragment" Language="cs"><![CDATA[
                var sb = new StringBuilder();
                sb.AppendLine("// <auto-generated/>");
                sb.AppendLine("// Generated from Schemas/*.json by the EmbedJsonSchemas task in Main.csproj. Do not edit.");
                sb.AppendLine("namespace DevOnBike.Overfit.Schemas");
                sb.AppendLine("{");
                sb.AppendLine("    internal static class OverfitSchemas");
                sb.AppendLine("    {");

                // Every Schemas/*.json across the tree collapses into this ONE class, so the file name is the
                // const name and must be globally unique. Without this check a collision surfaces as a baffling
                // "duplicate member" error in generated code the author never wrote.
                var seen = new Dictionary<string, string>();
                foreach (var item in Schemas)
                {
                    var path = item.GetMetadata("FullPath");
                    if (!File.Exists(path)) { continue; }
                    var name = Path.GetFileNameWithoutExtension(path);

                    string previous;
                    if (seen.TryGetValue(name, out previous))
                    {
                        Log.LogError("OVERFIT-SCHEMA-DUP: two schema files map to the same const 'OverfitSchemas.{0}'. Schema file names must be unique across ALL Schemas/ folders. Conflict: {1} vs {2}", name, previous, path);
                        continue;
                    }
                    seen.Add(name, path);

                    var json = File.ReadAllText(path);
                    sb.AppendLine("        public const string " + name + " = @\"" + json.Replace("\"", "\"\"") + "\";");
                }
                sb.AppendLine("    }");
                sb.AppendLine("}");

                var dir = Path.GetDirectoryName(OutputFile);
                if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir)) { Directory.CreateDirectory(dir); }
                File.WriteAllText(OutputFile, sb.ToString());
            ]]></Code>
		</Task>
	</UsingTask>

	<ItemGroup>
		<OverfitJsonSchema Include="**\Schemas\*.json" />
	</ItemGroup>

	<!-- Keep $(IntermediateOutputPath) in target attributes only: the SDK targets that define it import after
         this body, so a PropertyGroup here would silently resolve to an empty path. -->
	<Target Name="GenerateOverfitSchemas" BeforeTargets="CoreCompile"
            Inputs="@(OverfitJsonSchema)" Outputs="$(IntermediateOutputPath)OverfitSchemas.g.cs">
		<EmbedJsonSchemas Schemas="@(OverfitJsonSchema)"
                          OutputFile="$(IntermediateOutputPath)OverfitSchemas.g.cs" />
	</Target>

	<Target Name="IncludeOverfitSchemas" BeforeTargets="CoreCompile" DependsOnTargets="GenerateOverfitSchemas">
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)OverfitSchemas.g.cs" />
		</ItemGroup>
	</Target>

</Project>
