<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The AOT-ready ASP.NET (Kestrel + Minimal API) host for Overfit's OpenAI-compatible server — the
      shipping server behind the NuGet package and the Docker image. It reuses the transport-neutral
      ChatCompletionExchange from DevOnBike.Overfit.Server, so it is a thin Kestrel adapter, not a second
      implementation of the protocol.

      AOT: kept trim/AOT-clean (IsAotCompatible) and built with the Request Delegate Generator so the
      endpoint routing carries no reflection. The consuming executable (the `overfit` CLI) sets
      PublishAot=true; the CI aot-guard job publishes it under Native AOT with warnings-as-errors, which
      is where ILComplier actually verifies this graph.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <PackageId>DevOnBike.Overfit.Server.AspNet</PackageId>
        <RootNamespace>DevOnBike.Overfit.Server.AspNet</RootNamespace>

        <!-- NOT PUBLISHED, and this line is what makes that a decision rather than an omission.
             Added 2026-08-13 after the release gate found the project packs: it carries a PackageId but
             none of the metadata its published siblings set (Server, Mcp, Extensions.AI all declare
             Description, PackageLicenseFile and PackageReadmeFile), and `dotnet pack` produced it with
             NuGet warning about the missing readme.

             The missing metadata was the SYMPTOM, not the defect. `DevOnBike.Overfit.Server.AspNet` has
             never existed on nuget.org — checked, zero versions, against 8-11 for every sibling — because
             this assembly hosts `RedactionGateway`, which is on-prem commercial work and not part of the
             published surface. Filling in a description and a licence file would have made it shippable,
             which is the opposite of what is wanted.

             Nothing leaked: `.github/workflows/publish-nuget.yml` packs an explicit five-project list
             (Main, Extensions.AI, Server, Mcp, Cli) and only then pushes `./packages/*.nupkg`. That
             protection lives in a workflow file, so it holds only while nobody adds a project to that list
             or switches it to a solution-wide glob. This line holds regardless. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <!-- The shared protocol handler, DTOs and the source-gen JSON context live here. -->
        <ProjectReference Include="..\Server\Server.csproj" />
        <ProjectReference Include="..\Main\Main.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Anomalies\Anomalies.csproj" />
    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <AdditionalFiles Include="BannedSymbols.txt" />
    </ItemGroup>
</Project>
